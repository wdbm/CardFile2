def unique_tag():
    while True:
        tag = str(uuid.uuid4())[:8]
        if any(character.isalpha() for character in tag):
            return tag


def new_uid():
    return "urn:uuid:" + str(uuid.uuid4())


def utc_stamp():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H%M%S%fZ")


def safe_text(value):
    # Undecodable source bytes are retained by the model, but cannot be sent to Tk.
    return "".join(
        "\ufffd" if 0xD800 <= ord(character) <= 0xDFFF or
        (ord(character) < 32 and character not in "\n\t") else character
        for character in value
    )


def search_key(value):
    return "".join(character for character in unicodedata.normalize("NFKD", safe_text(value).casefold())
                   if not unicodedata.combining(character))


def split_quoted(value, delimiter):
    parts, start, quoted, escaped = [], 0, False, False
    for index, character in enumerate(value):
        if escaped:
            escaped = False
        elif character == "\\":
            escaped = True
        elif character == '"':
            quoted = not quoted
        elif character == delimiter and not quoted:
            parts.append(value[start:index])
            start = index + 1
    parts.append(value[start:])
    return parts


def split_structured(value):
    # Quotes are literal text here; only escaped semicolons are protected.
    parts, current, escaped = [], [], False
    for character in value:
        if character == ";" and not escaped:
            parts.append("".join(current))
            current = []
        else:
            current.append(character)
        escaped = character == "\\" and not escaped
    return parts + ["".join(current)]


def unescape_text(value):
    return re.sub(r"\\([nN,;\\:])", lambda match: "\n" if match[1] in "nN" else match[1], value)


def escape_text(value):
    return value.replace("\\", "\\\\").replace("\r\n", "\n").replace("\r", "\n").replace(
        "\n", "\\n").replace(";", "\\;").replace(",", "\\,")


def fold_line(value, line_ending="\r\n"):
    parts, current, size = [], [], 0
    for character in value:
        width = len(character.encode("utf-8", errors="surrogateescape"))
        if size + width > 75:
            parts.append("".join(current))
            current, size = [" "], 1
        current.append(character)
        size += width
    parts.append("".join(current))
    return line_ending.join(parts) + line_ending


def detect_line_ending(text):
    counts = {
        "\r\n": text.count("\r\n"),
        "\n": text.count("\n") - text.count("\r\n"),
        "\r": text.count("\r") - text.count("\r\n"),
    }
    present = [(count, ending) for ending, count in counts.items() if count]
    return max(present, default=(0, "\r\n"))[1]


def valid_date_value(value, require_time=False):
    value = value.strip()
    if not value or (require_time and "T" not in value.upper()):
        return False
    try:
        if "T" in value.upper():
            datetime.fromisoformat(value.upper().replace("Z", "+00:00"))
        elif re.fullmatch(r"\d{8}", value):
            datetime.strptime(value, "%Y%m%d")
        else:
            date.fromisoformat(value)
    except ValueError:
        return False
    return True


def valid_base64_value(value):
    try:
        base64.b64decode("".join(value.split()).encode("ascii"), validate=True)
    except (UnicodeEncodeError, binascii.Error, ValueError):
        return False
    return True


@dataclass(eq=False)
class Property:
    header: str
    value: str
    original: str | None = None

    @property
    def name(self):
        return self.header.split(";", 1)[0].rsplit(".", 1)[-1].upper()

    @property
    def group(self):
        identifier = self.header.split(";", 1)[0]
        return identifier.split(".", 1)[0] if "." in identifier else ""

    def parameter(self, name):
        values = []
        for parameter in split_quoted(self.header, ";")[1:]:
            key, separator, value = parameter.partition("=")
            if key.upper() == name.upper() and separator:
                values.append(value.strip('"'))
            elif name.upper() == "TYPE" and not separator:
                values.append(key)
        return ",".join(values)

    def preference_rank(self):
        preference = self.parameter("PREF")
        preference_values = [int(item) for item in preference.split(",") if item.isdigit()]
        if preference_values:
            return max(1, min(preference_values))
        types = {item.strip().upper() for item in self.parameter("TYPE").split(",")}
        return 1 if "PREF" in types else 1000

    @property
    def is_binary(self):
        return self.parameter("ENCODING").upper() in {"B", "BASE64"}

    @property
    def is_uri(self):
        return self.parameter("VALUE").upper() == "URI" or self.name in URI_FIELDS

    def decoded_value(self):
        if self.parameter("ENCODING").upper() == "QUOTED-PRINTABLE":
            data = quopri.decodestring(self.value.encode("utf-8", errors="surrogateescape"))
            try:
                return data.decode(self.parameter("CHARSET") or "utf-8", errors="replace")
            except LookupError:
                return data.decode("utf-8", errors="replace")
        charset = self.parameter("CHARSET")
        if charset:
            try:
                return self.value.encode("utf-8", errors="surrogateescape").decode(charset)
            except (LookupError, UnicodeError):
                pass
        return self.value

    def display_value(self):
        if self.is_binary:
            return "[Binary data retained: {} characters]".format(len(self.value))
        value = self.decoded_value()
        if self.is_uri:
            return safe_text(value)
        if self.name in {"N", "ADR", "ORG"}:
            return safe_text("; ".join(unescape_text(part) for part in split_structured(value)))
        return safe_text(unescape_text(value))

    def serialise(self, line_ending="\r\n"):
        return self.original if self.original is not None else fold_line(self.header + ":" + self.value, line_ending)


def parse_property(logical, original=None):
    parts = split_quoted(logical, ":")
    if len(parts) < 2:
        return None
    header = parts[0]
    if not re.fullmatch(r"(?:[A-Za-z0-9-]+\.)?[A-Za-z0-9-]+(?:;[^\r\n]*)?", header):
        return None
    return Property(header, ":".join(parts[1:]), original)


@dataclass(eq=False)
class Card:
    entries: list = field(default_factory=list)
    opening: str = "BEGIN:VCARD\r\n"
    closing: str = "END:VCARD\r\n"
    tag: str = field(default_factory=unique_tag)
    line_ending: str = "\r\n"

    def properties(self, name=None):
        return [entry for entry in self.entries if isinstance(entry, Property)
                and (name is None or entry.name == name)]

    def first(self, name):
        values = self.properties(name)
        return values[0].display_value() if values else ""

    def preferred(self, name):
        values = self.properties(name)
        if not values:
            return ""
        return min(enumerate(values), key=lambda item: (item[1].preference_rank(), item[0]))[1].display_value()

    @property
    def title(self):
        return self.first("FN").strip() or self.first("N").strip("; ") or self.preferred("EMAIL") or "Unnamed contact"

    def serialise(self):
        return self.opening + "".join(entry.serialise(self.line_ending) if isinstance(entry, Property) else entry
                                      for entry in self.entries) + self.closing

    def touch(self):
        revision = Property("REV", datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ"))
        existing = self.properties("REV")
        if existing:
            self.entries[self.entries.index(existing[0])] = revision
        else:
            self.append(revision)

    def append(self, entry):
        if self.entries:
            last = self.entries[-1]
            text = last.serialise(self.line_ending) if isinstance(last, Property) else last
            if not text.endswith(("\n", "\r")):
                self.entries.append(self.line_ending)
        elif not self.opening.endswith(("\n", "\r")):
            self.opening += self.line_ending
        self.entries.append(entry)

    def issues(self):
        issues = []
        if not self.closing:
            issues.append("Missing END:VCARD. Use 'Repair boundaries' to add it.")
        if self.first("VERSION") != "3.0":
            issues.append("VERSION is missing or is not 3.0; no version conversion is performed.")
        for name in ("FN", "N"):
            if not self.properties(name):
                issues.append("Required field {} is missing.".format(name))
        for name in ("FN", "N", "VERSION", "UID"):
            if len(self.properties(name)) > 1:
                issues.append("More than one {} field is present; all entries are retained.".format(name))
        for entry in self.entries:
            if isinstance(entry, str) and entry.strip():
                issues.append("An unrecognised line is retained: " + safe_text(entry.strip())[:100])
            elif isinstance(entry, Property):
                if entry.parameter("ENCODING").upper() == "QUOTED-PRINTABLE":
                    issues.append("Legacy quoted-printable encoding is retained for {}.".format(entry.header))
                if entry.is_binary and entry.value and not valid_base64_value(entry.value):
                    issues.append("{} contains invalid base64 data; the original is retained.".format(entry.header))
                if entry.name in DATE_FIELDS and entry.value and not valid_date_value(entry.decoded_value()):
                    issues.append("{} does not contain a valid date or date-time.".format(entry.header))
                if entry.name == "REV" and entry.value and not valid_date_value(entry.decoded_value(), require_time=True):
                    issues.append("REV does not contain a valid date-time.")
                if entry.name in {"N", "ADR"}:
                    count = 5 if entry.name == "N" else 7
                    if len(split_structured(entry.decoded_value())) != count:
                        issues.append("{} should have {} components; the original is retained.".format(entry.name, count))
        raw = self.serialise()
        if any(0xDC80 <= ord(character) <= 0xDCFF for character in raw):
            issues.append("Invalid UTF-8 bytes are displayed as replacement characters and retained until that field is edited.")
        if "\ufffd" in raw or any(marker in raw for marker in ("\u00c3", "\u00c2", "\u00e2\u20ac")):
            issues.append("Some text may be damaged. A text repair can be previewed when editing a field.")
        return issues


@dataclass
class Document:
    elements: list = field(default_factory=list)
    line_ending: str = "\r\n"

    @classmethod
    def from_bytes(cls, data):
        text = data.decode("utf-8", errors="surrogateescape")
        document, card = cls(line_ending=detect_line_ending(text)), None
        if text.startswith("\ufeff"):
            document.elements.append("\ufeff")
            text = text[1:]
        lines = re.findall(r"[^\r\n]*(?:\r\n|\r|\n|$)", text)
        logical, physical = "", ""

        def flush():
            nonlocal logical, physical
            if physical:
                card.entries.append(parse_property(logical, physical) or physical)
            logical, physical = "", ""

        for line in lines:
            if not line:
                continue
            content = line.rstrip("\r\n")
            marker = content.strip().upper()
            if marker == "BEGIN:VCARD":
                if card is not None:
                    flush()
                card = Card(opening=line, closing="", line_ending=document.line_ending)
                document.elements.append(card)
            elif marker == "END:VCARD" and card is not None:
                flush()
                card.closing = line
                card = None
            elif card is None:
                document.elements.append(line)
            else:
                pending = parse_property(logical) if physical else None
                if pending and pending.parameter("ENCODING").upper() == "QUOTED-PRINTABLE" and logical.endswith("="):
                    logical = logical[:-1] + (content[1:] if content.startswith((" ", "\t")) else content)
                    physical += line
                elif content.startswith((" ", "\t")) and physical:
                    logical += content[1:]
                    physical += line
                else:
                    flush()
                    logical, physical = content, line
        if card is not None:
            flush()
        return document

    @property
    def cards(self):
        return [element for element in self.elements if isinstance(element, Card)]

    def to_bytes(self):
        return "".join(element.serialise() if isinstance(element, Card) else element
                       for element in self.elements).encode("utf-8", errors="surrogateescape")

    def issues(self):
        issues = []
        if any(isinstance(element, str) and element.strip("\ufeff \r\n\t") for element in self.elements):
            issues.append("Text outside contact boundaries is retained unchanged.")
        seen = set()
        for card in self.cards:
            uid = card.first("UID")
            if uid and uid in seen:
                issues.append("Duplicate UID: " + uid)
            seen.add(uid)
            issues.extend("{}: {}".format(card.title, issue) for issue in card.issues())
        return issues

    def append(self, card):
        if self.elements and not self.to_bytes().endswith((b"\n", b"\r")):
            self.elements.append(self.line_ending)
        card.line_ending = self.line_ending
        self.elements.append(card)


def new_card(full_name="New contact", family_name="", given_name="", line_ending="\r\n"):
    return Card(entries=[Property("VERSION", "3.0"), Property("UID", new_uid()),
                         Property("PRODID", "-//CardFile2//EN"), Property("FN", escape_text(full_name)),
                         Property("N", ";".join(map(escape_text, (family_name, given_name, "", "", ""))))],
                opening="BEGIN:VCARD" + line_ending, closing="END:VCARD" + line_ending,
                line_ending=line_ending)


def fingerprint(data):
    return hashlib.sha256(data).hexdigest()


class ExternalChangeError(OSError):
    pass


def save_document(path, document, expected_fingerprint=None):
    """
    Create an exclusive backup and atomically replace the destination.

    A failed backup prevents replacement. Original undecodable bytes are retained.
    """
    path = Path(path).expanduser().resolve()
    old_data = path.read_bytes() if path.exists() else None
    if expected_fingerprint is not None and (old_data is None or fingerprint(old_data) != expected_fingerprint):
        raise ExternalChangeError("The file has changed outside CardFile2. Use Save as, or reopen it before saving.")
    data = document.to_bytes()
    backup = None
    if old_data is not None:
        backup = path.with_name("{}-{}-{}.bak".format(utc_stamp(), unique_tag(), path.name))
        descriptor = os.open(backup, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(old_data)
            stream.flush()
            os.fsync(stream.fileno())
    descriptor, temporary = tempfile.mkstemp(prefix=".cardfile2-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        if old_data is not None:
            os.chmod(temporary, stat.S_IMODE(path.stat().st_mode))
        # Recheck after writing the temporary file to catch most concurrent edits.
        if (path.read_bytes() if path.exists() else None) != old_data:
            raise ExternalChangeError("The destination changed during saving. Use Save as to keep both versions.")
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    return backup


def repair_candidates(value):
    candidates = []
    for encoding in ("cp1252", "latin-1"):
        try:
            candidate = value.encode(encoding).decode("utf-8")
        except UnicodeError:
            continue
        if candidate != value and candidate not in candidates:
            candidates.append(candidate)
    return candidates


# GUI imports are deferred so parsing and file handling can be used without Tk.
def load_gui():
    global tk, ttk, messagebox, filedialog, simpledialog, ScrolledText
    import tkinter as tk
    from tkinter import ttk, messagebox, filedialog, simpledialog
    from tkinter.scrolledtext import ScrolledText


class PropertyDialog:
    def __init__(self, parent, entry=None):
        self.result = None
        self.entry = entry
        self.window = tk.Toplevel(parent)
        self.window.title("Edit field" if entry else "Add field")
        self.window.transient(parent)
        self.window.geometry("680x560")
        self.window.minsize(520, 420)
        frame = ttk.Frame(self.window, padding=18)
        frame.pack(fill="both", expand=True)
        ttk.Label(frame, text="Field", style="Heading.TLabel").pack(anchor="w")
        self.header = tk.StringVar(value=entry.header if entry else "EMAIL;TYPE=HOME")
        self.header_box = ttk.Combobox(frame, textvariable=self.header, values=[
            "FN", "N", "EMAIL;TYPE=HOME", "EMAIL;TYPE=WORK", "TEL;TYPE=CELL", "ADR;TYPE=HOME",
            "ADR;TYPE=WORK", "URL", "NOTE", "ORG", "TITLE", "BDAY", "CATEGORIES",
            "ITEM1.EMAIL", "ITEM1.X-ABLABEL", "X-SOCIALPROFILE;TYPE=mastodon", "X-SKYPE"])
        self.header_box.pack(fill="x", pady=(8, 4))
        ttk.Label(frame, text="A group and parameters can be included, such as ITEM1.EMAIL;TYPE=HOME.",
                  wraplength=610).pack(anchor="w")
        self.raw_mode = tk.BooleanVar(value=bool(entry and (
            entry.is_binary or entry.name in STRUCTURED_FIELDS)))
        self.raw_toggle = ttk.Checkbutton(
            frame, text="Encoded value (keep vCard escapes and structured separators)",
            variable=self.raw_mode, command=self.switch_mode)
        self.raw_toggle.pack(anchor="w", pady=(14, 4))
        ttk.Label(frame, text="For N: family;given;additional;prefix;suffix\n"
                  "For ADR: PO box;extended;street;town;region;postcode;country",
                  wraplength=620).pack(anchor="w")
        self.value = ScrolledText(frame, height=10, wrap="word", undo=True, font=("TkDefaultFont", 11))
        self.value.pack(fill="both", expand=True, pady=10)
        initial = (entry.value if self.raw_mode.get() else entry.display_value()) if entry else ""
        self.value.insert("1.0", safe_text(initial))
        self.initial_value = safe_text(initial)
        self.initial_mode = self.raw_mode.get()
        ttk.Label(frame, text="Plain text is escaped automatically. Edited plain text is saved as UTF-8.",
                  wraplength=620).pack(anchor="w")
        buttons = ttk.Frame(frame)
        buttons.pack(fill="x", pady=(14, 0))
        ttk.Button(buttons, text="Preview text repair", command=self.repair).pack(side="left")
        ttk.Button(buttons, text="Cancel", command=self.window.destroy).pack(side="right")
        ttk.Button(buttons, text="Apply", command=self.apply).pack(side="right", padx=8)
        self.window.bind("<Escape>", lambda event: self.window.destroy())
        self.window.bind("<Control-Return>", lambda event: self.apply())
        self.header_box.bind("<<ComboboxSelected>>", self.header_changed)
        self.header_box.bind("<FocusOut>", self.header_changed)
        self.header_changed()
        self.window.grab_set()
        self.value.focus_set()
        parent.wait_window(self.window)

    def header_changed(self, event=None):
        probe = parse_property(self.header.get().strip() + ":")
        if probe and probe.name in STRUCTURED_FIELDS:
            self.raw_mode.set(True)
            self.raw_toggle.configure(state="disabled")
        else:
            self.raw_toggle.configure(state="normal")

    def switch_mode(self):
        value = self.value.get("1.0", "end-1c")
        prop = parse_property(self.header.get() + ":" + value)
        if prop and prop.name in STRUCTURED_FIELDS:
            self.raw_mode.set(True)
            return
        if prop and not prop.is_uri and not prop.is_binary:
            if self.raw_mode.get():
                value = escape_text(value)
            else:
                value = prop.display_value()
            self.value.delete("1.0", "end")
            self.value.insert("1.0", value)

    def repair(self):
        value = self.value.get("1.0", "end-1c")
        candidates = repair_candidates(value)
        if not candidates:
            messagebox.showinfo("Text repair", "No reversible encoding repair was found. The text can be edited manually.", parent=self.window)
        elif messagebox.askyesno("Preview text repair", "Use this suggested text?\n\n" + candidates[0], parent=self.window):
            self.value.delete("1.0", "end")
            self.value.insert("1.0", candidates[0])

    def apply(self):
        header = self.header.get().strip()
        value = self.value.get("1.0", "end-1c")
        probe = parse_property(header + ":")
        if probe is None or probe.header != header or probe.name in {"BEGIN", "END"}:
            messagebox.showerror("Invalid field", "Enter a field name with optional group and parameters, without a value or colon.", parent=self.window)
            return
        if probe.name in STRUCTURED_FIELDS and not self.raw_mode.get():
            messagebox.showerror("Structured field", "Structured and list-valued fields must be edited in encoded-value mode so their separators are retained.", parent=self.window)
            return
        if self.entry and header == self.entry.header and value == self.initial_value and self.raw_mode.get() == self.initial_mode:
            self.window.destroy()
            return
        if self.raw_mode.get():
            if "\n" in value or "\r" in value:
                messagebox.showerror("Invalid encoded value", "Use \\n for an encoded line break, or switch to plain text.", parent=self.window)
                return
        else:
            if probe.is_binary:
                messagebox.showerror("Binary field", "Use encoded value mode to edit binary data.", parent=self.window)
                return
            header = ";".join(part for part in split_quoted(header, ";")
                              if part.split("=", 1)[0].upper() not in {"CHARSET", "ENCODING"})
            if probe.is_uri:
                if "\n" in value or "\r" in value:
                    messagebox.showerror("Invalid URI", "A URI must fit on a single line.", parent=self.window)
                    return
            else:
                value = escape_text(value)
        if self.entry and any(0xDC80 <= ord(character) <= 0xDCFF for character in self.entry.value):
            if not messagebox.askyesno("Replace damaged bytes", "This field contains undecodable bytes. Applying this edit will replace them with the displayed text. Continue?", parent=self.window):
                return
        self.result = Property(header, value)
        self.window.destroy()


def can_use_address_editor(entry):
    if entry is None:
        return True
    return (entry.name == "ADR" and not entry.parameter("ENCODING") and
            len(split_structured(entry.value)) <= len(ADDRESS_PARTS) and
            not any(0xD800 <= ord(character) <= 0xDFFF for character in entry.value))


class AddressDialog:
    def __init__(self, parent, entry=None):
        self.result = None
        self.entry = entry
        self.window = tk.Toplevel(parent)
        self.window.title("Edit address" if entry else "Add address")
        self.window.transient(parent)
        self.window.geometry("700x500")
        self.window.minsize(560, 430)
        frame = ttk.Frame(self.window, padding=18)
        frame.pack(fill="both", expand=True)
        ttk.Label(frame, text="Address", style="Heading.TLabel").grid(row=0, column=0, columnspan=2, sticky="w", pady=(0, 10))
        ttk.Label(frame, text="Field and parameters").grid(row=1, column=0, sticky="w", padx=(0, 14), pady=5)
        self.header = tk.StringVar(value=entry.header if entry else "ADR;TYPE=HOME")
        ttk.Entry(frame, textvariable=self.header).grid(row=1, column=1, sticky="ew", pady=5)
        parts = split_structured(entry.value) if entry else []
        parts = (parts + [""] * len(ADDRESS_PARTS))[:len(ADDRESS_PARTS)]
        self.values = []
        for row, (label, value) in enumerate(zip(ADDRESS_PARTS, parts), start=2):
            ttk.Label(frame, text=label).grid(row=row, column=0, sticky="w", padx=(0, 14), pady=5)
            variable = tk.StringVar(value=safe_text(value))
            self.values.append(variable)
            ttk.Entry(frame, textvariable=variable).grid(row=row, column=1, sticky="ew", pady=5)
        ttk.Label(frame, text="Component values use vCard escapes. A comma separates multiple values; use \\, for a literal comma.",
                  wraplength=620).grid(row=9, column=0, columnspan=2, sticky="w", pady=(10, 4))
        buttons = ttk.Frame(frame)
        buttons.grid(row=10, column=0, columnspan=2, sticky="e", pady=(14, 0))
        ttk.Button(buttons, text="Cancel", command=self.window.destroy).pack(side="left", padx=6)
        ttk.Button(buttons, text="Apply", command=self.apply).pack(side="left")
        frame.columnconfigure(1, weight=1)
        self.window.bind("<Escape>", lambda event: self.window.destroy())
        self.window.bind("<Control-Return>", lambda event: self.apply())
        self.window.grab_set()
        self.window.wait_window()

    def apply(self):
        header = self.header.get().strip()
        probe = parse_property(header + ":")
        if probe is None or probe.header != header or probe.name != "ADR":
            messagebox.showerror("Invalid address field", "Enter ADR with optional group and parameters, such as ITEM1.ADR;TYPE=HOME.", parent=self.window)
            return
        value = ";".join(variable.get() for variable in self.values)
        if any("\n" in variable.get() or "\r" in variable.get() for variable in self.values):
            messagebox.showerror("Invalid address", "Use \\n inside an encoded component rather than a physical line break.", parent=self.window)
            return
        if self.entry and header == self.entry.header and value == self.entry.value:
            self.window.destroy()
            return
        self.result = Property(header, value)
        self.window.destroy()


