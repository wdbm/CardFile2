        menu.add_cascade(label="File", menu=file_menu)
        help_menu = tk.Menu(menu, tearoff=False)
        help_menu.add_command(label="About and help", command=lambda: messagebox.showinfo(
            "CardFile2", "CardFile2\n\nA local vCard editor.\n\n"
            "Select a contact to view details. Use All fields to edit repeated entries, addresses and custom properties. "
            "Double-click a field to edit it. Changes can be undone until another file is opened.\n\n"
            "Existing files are backed up when saved. File checks report damaged data without removing it.\n\n"
            "Ctrl+O:\topen\nCtrl+S:\tsave\nCtrl+F:\tsearch\nCtrl+N:\tnew contact\nCtrl+Z:\tundo\nCtrl+Y:\tredo".format(__VERSION__), parent=self.root))
        menu.add_cascade(label="Help", menu=help_menu)
        self.root.config(menu=menu)

    def tree(self, parent, columns, headings, widths):
        frame = ttk.Frame(parent)
        frame.pack(fill="both", expand=True)
        tree = ttk.Treeview(frame, columns=columns, show="headings", selectmode="browse")
        for column, heading, width in zip(columns, headings, widths):
            tree.heading(column, text=heading)
            tree.column(column, width=width, minwidth=80)
        scroll = ttk.Scrollbar(frame, orient="vertical", command=tree.yview)
        horizontal = ttk.Scrollbar(frame, orient="horizontal", command=tree.xview)
        tree.configure(yscrollcommand=scroll.set, xscrollcommand=horizontal.set)
        tree.grid(row=0, column=0, sticky="nsew")
        scroll.grid(row=0, column=1, sticky="ns")
        horizontal.grid(row=1, column=0, sticky="ew")
        frame.rowconfigure(0, weight=1)
        frame.columnconfigure(0, weight=1)
        return tree

    def readonly_text(self, parent, monospace=False):
        widget = ScrolledText(parent, wrap="word",
                              font=("TkFixedFont" if monospace else "TkTextFont", 10), width=40, height=10)
        widget.pack(fill="both", expand=True)
        widget.configure(state="disabled")
        return widget

    def set_text(self, widget, text):
        widget.configure(state="normal")
        widget.delete("1.0", "end")
        widget.insert("1.0", safe_text(text))
        widget.configure(state="disabled")

    @property
    def current_card(self):
        return next((card for card in self.document.cards if card.tag == self.current_tag), None)

    @property
    def dirty(self):
        return self.document.to_bytes() != self.saved_data

    def checkpoint(self):
        self.history.append((copy.deepcopy(self.document), self.current_tag))
        self.history = self.history[-50:]
        self.future.clear()

    def undo(self):
        if self.history:
            self.future.append((copy.deepcopy(self.document), self.current_tag))
            self.document, self.current_tag = self.history.pop()
            self.refresh_contacts()

    def redo(self):
        if self.future:
            self.history.append((copy.deepcopy(self.document), self.current_tag))
            self.document, self.current_tag = self.future.pop()
            self.refresh_contacts()

    def refresh_contacts(self):
        self.refreshing = True
        self.contacts.delete(*self.contacts.get_children())
        query = search_key(self.search.get())
        cards = sorted(self.document.cards, key=lambda card: search_key(card.title))
        visible = []
        for card in cards:
            if query and query not in search_key(" ".join(prop.display_value() + " " + prop.header for prop in card.properties())):
                continue
            visible.append(card.tag)
            self.contacts.insert("", "end", iid=card.tag, values=(safe_text(card.title), card.preferred("EMAIL")))
        if self.current_tag not in visible:
            self.current_tag = visible[0] if visible else None
        if self.current_tag:
            self.contacts.selection_set(self.current_tag)
            self.contacts.see(self.current_tag)
        self.refreshing = False
        self.show_contact()
        issues = self.document.issues()
        self.set_text(self.diagnostics, "\n\n".join(issues) if issues else "No structural or text issues were detected.")
        name = str(self.path) if self.path else "Untitled address book"
        self.path_label.config(text=safe_text(name))
        self.root.title("{}{} - CardFile2".format("* " if self.dirty else "", safe_text(self.path.name) if self.path else "Untitled"))
        self.status.config(text="{} of {} contacts | {} | {} file check(s)".format(
            len(visible), len(cards), "Unsaved changes" if self.dirty else "Saved", len(issues)))

    def select_contact(self, event=None):
        if not self.refreshing:
            selection = self.contacts.selection()
            self.current_tag = selection[0] if selection else None
            self.show_contact()

    def show_contact(self):
        card = self.current_card
        self.fields.delete(*self.fields.get_children())
        self.title_label.config(text=safe_text(card.title) if card else "No contact selected")
        if card:
            details = list(filter(None, (card.first("ORG"), card.first("TITLE"))))
            if card.first("VERSION") != "3.0" and card.tag not in self.version_edit_overrides:
                details.append("Version {}: confirmation is required before editing".format(card.first("VERSION") or "unknown"))
            self.subtitle.config(text=" | ".join(details))
        else:
            self.subtitle.config(text="Open a VCF file or add a contact.")
        self.set_text(self.overview, "")
        # CRLF is required for vCard files, but carriage returns are displayed as
        # replacement glyphs by some Tk text widgets. The source view therefore
        # normalises line endings for presentation only; the stored source is
        # left unchanged and is still written with its original line endings.
        source_text = card.serialise().replace("\r\n", "\n").replace("\r", "\n") if card else ""
        self.set_text(self.source, source_text)
        if card is None:
            return
        self.overview.configure(state="normal")
        labels = {prop.group.casefold(): prop.display_value() for prop in card.properties("X-ABLABEL") if prop.group}
        for index, entry in enumerate(card.entries):
            if isinstance(entry, Property):
                value = entry.display_value()
                self.fields.insert("", "end", iid=str(index), values=(safe_text(entry.header), value.replace("\n", " / ")[:500]))
                if entry.name in {"VERSION", "PRODID", "UID", "REV", "FN", "X-ABLABEL"}:
                    continue
                label = FIELD_NAMES.get(entry.name, entry.name)
                detail = labels.get(entry.group.casefold()) or entry.parameter("TYPE")
                if detail:
                    label += " ({})".format(safe_text(detail))
                self.overview.insert("end", label + "\n", "label")
                self.overview.insert("end", value + "\n")
            elif entry.strip():
                self.fields.insert("", "end", iid=str(index), values=("Unrecognised line (retained)", safe_text(entry.strip())[:500]))
        self.overview.configure(state="disabled")

    def add_contact(self):
        name = simpledialog.askstring("New contact", "Full name:", parent=self.root)
        if name is None or not name.strip():
            return
        self.checkpoint()
        card = new_card(name.strip(), line_ending=self.document.line_ending)
        card.touch()
        self.document.append(card)
        self.current_tag = card.tag
        self.search.set("")
        self.refresh_contacts()

    def delete_contact(self):
        card = self.current_card
        if card and self.ensure_editable(card) and messagebox.askyesno("Delete contact", "Delete {}? This change can be undone.".format(safe_text(card.title)), parent=self.root):
            self.checkpoint()
            self.document.elements.remove(card)
            self.refresh_contacts()

    def edit_name(self):
        card = self.current_card
        if card is None or not self.ensure_editable(card):
            return
        # Each structured component is edited separately, without guessing name order.
        window = tk.Toplevel(self.root)
        window.title("Edit name")
        window.transient(self.root)
        frame = ttk.Frame(window, padding=18)
        frame.pack(fill="both", expand=True)
        prop = next(iter(card.properties("N")), None)
        parts = split_structured(prop.decoded_value()) if prop else []
        name_properties = card.properties("N") + card.properties("FN")
        damaged_name = any(any(0xDC80 <= ord(character) <= 0xDCFF for character in item.value)
                           for item in name_properties)
        if len(parts) > 5 or (prop and prop.parameter("ENCODING")) or damaged_name:
            window.destroy()
            self.edit_property(next((item for item in name_properties if any(
                0xDC80 <= ord(character) <= 0xDCFF for character in item.value)), prop))
            return
        values = [card.first("FN")] + [safe_text(unescape_text(part)) for part in (parts + [""] * 5)[:5]]
        variables = []
        for row, (label, value) in enumerate(zip(("Full name",) + NAME_PARTS, values)):
            ttk.Label(frame, text=label).grid(row=row, column=0, sticky="w", padx=(0, 14), pady=6)
            variable = tk.StringVar(value=value)
            variables.append(variable)
            ttk.Entry(frame, textvariable=variable, width=45).grid(row=row, column=1, sticky="ew", pady=6)

        def apply():
            updated = [variable.get() for variable in variables]
            if not updated[0].strip():
                messagebox.showerror("Missing name", "A full name is required.", parent=window)
                return
            if updated != values:
                self.checkpoint()
                for name, value, changed in (("FN", escape_text(updated[0]), updated[0] != values[0]),
                                             ("N", ";".join(map(escape_text, updated[1:])), updated[1:] != values[1:] or prop is None)):
                    if changed:
                        existing = card.properties(name)
                        replacement = Property(name, value)
                        if existing:
                            # Retain any group and non-encoding parameters on the name.
                            replacement.header = ";".join(part for part in split_quoted(existing[0].header, ";")
                                                         if part.split("=", 1)[0].upper() not in {"CHARSET", "ENCODING"})
                            card.entries[card.entries.index(existing[0])] = replacement
                        else:
                            card.append(replacement)
                card.touch()
                self.refresh_contacts()
            window.destroy()

        buttons = ttk.Frame(frame)
        buttons.grid(row=6, column=0, columnspan=2, sticky="e", pady=(12, 0))
        ttk.Button(buttons, text="Cancel", command=window.destroy).pack(side="left", padx=6)
        ttk.Button(buttons, text="Apply", command=apply).pack(side="left")
        window.bind("<Escape>", lambda event: window.destroy())
        window.grab_set()
        self.root.wait_window(window)

    def edit_notes(self):
        card = self.current_card
        if card and self.ensure_editable(card):
            self.edit_property(next(iter(card.properties("NOTE")), Property("NOTE", "")))

    def add_field(self):
        if self.current_card and self.ensure_editable(self.current_card):
            self.edit_property(None)

    def add_address(self):
        card = self.current_card
        if card is None or not self.ensure_editable(card):
            return
        dialog = AddressDialog(self.root)
        if dialog.result:
            self.checkpoint()
            card.append(dialog.result)
            card.touch()
            self.refresh_contacts()

    def edit_field(self):
        selection = self.fields.selection()
        if self.current_card and selection:
            entry = self.current_card.entries[int(selection[0])]
            if isinstance(entry, Property):
                if not self.ensure_editable(self.current_card):
                    return
                if entry.name == "ADR" and can_use_address_editor(entry):
                    self.edit_address(entry)
                else:
                    self.edit_property(entry)
            else:
                messagebox.showinfo("Unrecognised line", "This line is retained verbatim. A corrected field can be added, then the damaged line can be removed.\n\n" + safe_text(entry), parent=self.root)

    def edit_property(self, entry):
        card = self.current_card
        dialog = PropertyDialog(self.root, entry)
        if dialog.result:
            self.checkpoint()
            if entry in card.entries:
                card.entries[card.entries.index(entry)] = dialog.result
            else:
                card.append(dialog.result)
            if dialog.result.name != "REV":
                card.touch()
            self.refresh_contacts()

    def edit_address(self, entry):
        card = self.current_card
        dialog = AddressDialog(self.root, entry)
        if dialog.result:
            self.checkpoint()
            card.entries[card.entries.index(entry)] = dialog.result
            card.touch()
            self.refresh_contacts()

    def remove_field(self):
        card = self.current_card
        selection = self.fields.selection()
        if card and selection and self.ensure_editable(card) and messagebox.askyesno("Remove field", "Remove the selected field or damaged line? This change can be undone.", parent=self.root):
            self.checkpoint()
            del card.entries[int(selection[0])]
            card.touch()
            self.refresh_contacts()

    def repair_boundaries(self):
        cards = [card for card in self.document.cards if not card.closing]
        if not cards:
            messagebox.showinfo("Repair boundaries", "No missing END:VCARD boundaries were found.", parent=self.root)
            return
        cards = [card for card in cards if self.ensure_editable(card)]
        if not cards:
            return
        self.checkpoint()
        for card in cards:
            card.append("")
            card.closing = "END:VCARD" + card.line_ending
        self.refresh_contacts()

    def ensure_editable(self, card):
        version = card.first("VERSION")
        if version == "3.0" or card.tag in self.version_edit_overrides:
            return True
        answer = messagebox.askyesno(
            "Unsupported vCard version",
            "This contact uses vCard {}. CardFile2 is designed for vCard 3.0 and cannot guarantee a valid edit. "
            "Leave this contact unchanged unless the source is understood. Edit it anyway?".format(version or "with no declared version"),
            parent=self.root)
        if answer:
            self.version_edit_overrides.add(card.tag)
            self.show_contact()
        return answer

    def confirm_discard(self):
        if not self.dirty:
            return True
        answer = messagebox.askyesnocancel("Unsaved changes", "Save changes before continuing?", parent=self.root)
        return self.save() if answer else answer is False

    def load_path(self, path):
        path = Path(path).expanduser().resolve()
        try:
            data = path.read_bytes()
            document = Document.from_bytes(data)
        except OSError as error:
            messagebox.showerror("Cannot open file", str(error), parent=self.root)
            return False
        self.document, self.path = document, path
        self.loaded_fingerprint = fingerprint(data)
        self.saved_data = data
        self.history.clear()
        self.future.clear()
        self.version_edit_overrides.clear()
        self.current_tag = None
        self.search.set("")
        self.refresh_contacts()
        if data and not document.cards:
            messagebox.showwarning("No contacts found", "No BEGIN:VCARD records were found. The original text is retained. Another file can be opened, or contacts can be added.", parent=self.root)
        return True

    def open_file(self):
        if self.confirm_discard():
            path = filedialog.askopenfilename(parent=self.root, title="Open address book", filetypes=[("vCard files", "*.vcf"), ("All files", "*")])
            if path:
                self.load_path(path)

    def save(self):
        return self.write_path(self.path) if self.path else self.save_as()

    def save_as(self):
        path = filedialog.asksaveasfilename(parent=self.root, title="Save address book as", defaultextension=".vcf",
                                          initialfile=self.path.name if self.path else "contacts.vcf",
                                          filetypes=[("vCard files", "*.vcf"), ("All files", "*")])
        return self.write_path(Path(path)) if path else False

    def write_path(self, path):
        path = Path(path).expanduser().resolve()
        try:
            backup = save_document(path, self.document, self.loaded_fingerprint if path == self.path else None)
        except (OSError, UnicodeError) as error:
            messagebox.showerror("Cannot save file", str(error), parent=self.root)
            return False
        self.path = path
        self.saved_data = self.document.to_bytes()
        self.loaded_fingerprint = fingerprint(self.saved_data)
        self.refresh_contacts()
        self.status.config(text="Saved {}{}".format(safe_text(path.name), " | Backup: " + safe_text(backup.name) if backup else ""))
        return True

    def close(self):
        if self.confirm_discard():
            self.root.destroy()


def parse_arguments(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        from docopt import docopt
    except ImportError:
        if argv in (["-h"], ["--help"]):
            print(__doc__.strip())
            raise SystemExit(0)
        if argv == ["--version"]:
            print(__VERSION__)
            raise SystemExit(0)
        theme = None
        remaining = []
        index = 0
        while index < len(argv):
            argument = argv[index]
            if argument == "--":
                remaining.extend(argv[index + 1:])
                break
            if argument == "--theme":
                if index + 1 >= len(argv):
                    raise SystemExit("--theme requires a value")
                theme = argv[index + 1]
                index += 2
                continue
            if argument.startswith("--theme="):
                theme = argument.partition("=")[2]
            elif argument.startswith("-"):
                raise SystemExit("Usage: CardFile2.py [--theme=<theme>] [<vcf_file>]")
            else:
                remaining.append(argument)
            index += 1
        argv = remaining
        if len(argv) > 1:
            raise SystemExit("Usage: CardFile2.py [--theme=<theme>] [<vcf_file>]")
        return Path(argv[0] if argv else "contacts.vcf"), theme or None
    options = docopt(__doc__, argv=argv, version=__VERSION__)
    theme = options["--theme"]
    theme = theme.strip() if theme else None
    return Path(options["<vcf_file>"] or "contacts.vcf"), theme


def main(argv=None):
    path, theme = parse_arguments(argv)
    try:
        load_gui()
    except ImportError:
        print("Tkinter is required. Please install the Python Tk package supplied by the operating system.", file=sys.stderr)
        return 1
    try:
        root = tk.Tk()
    except tk.TclError as error:
        print("The graphical display could not be opened: {}".format(error), file=sys.stderr)
        return 1
    CardFileApp(root, path, theme=theme)
    root.mainloop()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
